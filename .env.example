# Ouroboros AI - Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to Git

# =====================================================
# APPLICATION
# =====================================================
APP_NAME=ouroboros-ai
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# =====================================================
# API
# =====================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# =====================================================
# MODELS
# =====================================================
MODELS_DIR=./models
RED_AGENT_MODEL=WhiteRabbitNeo-7B-v1.5a-Q4_K_M.gguf
BLUE_AGENT_MODEL=DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
SUPPORT_AGENT_MODEL=Phi-3.5-mini-instruct-Q6_K.gguf

# Model Configuration
GPU_LAYERS=35  # Number of layers to offload to GPU
N_CTX=4096  # Context window size
N_THREADS=8  # CPU threads

# =====================================================
# GITHUB
# =====================================================
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# =====================================================
# GOOGLE WORKSPACE
# =====================================================
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_DOCS_FOLDER_ID=your_folder_id

# =====================================================
# DATABASE
# =====================================================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ouroboros
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ImmuDB (Immutable Ledger)
IMMUDB_HOST=localhost
IMMUDB_PORT=3322
IMMUDB_USERNAME=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=ouroboros_audit

# =====================================================
# AWS (Optional - for Secrets Manager)
# =====================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# =====================================================
# OPA (Open Policy Agent)
# =====================================================
OPA_URL=http://localhost:8181
OPA_POLICY_DIR=./config/opa_policies

# =====================================================
# DOCKER
# =====================================================
DOCKER_NETWORK=ouroboros_network
DOCKER_SANDBOX_IMAGE=ouroboros-sandbox:latest

# =====================================================
# SECURITY
# =====================================================
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# =====================================================
# SCANNING TOOLS
# =====================================================
NUCLEI_TEMPLATES_DIR=./nuclei-templates
SEMGREP_RULES=p/security-audit,p/owasp-top-10
CHECKOV_FRAMEWORK=all

# =====================================================
# MONITORING
# =====================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/ouroboros.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =====================================================
# PERFORMANCE
# =====================================================
MAX_WORKERS=4
TIMEOUT_SCAN=300  # seconds
TIMEOUT_FIX=600  # seconds
MAX_VERIFICATION_RETRIES=10

# =====================================================
# COMPLIANCE
# =====================================================
COMPLIANCE_FRAMEWORKS=SOC2,ISO27001,GDPR,HIPAA,PCI-DSS
