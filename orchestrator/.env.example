# Copy this to .env and fill in values

# ── AWS Bedrock (primary — Qwen3-Coder via bearer token) ──────────────────────
# Set your bearer token here; the orchestrator wires it to LLM_API_KEY automatically.
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here
# Optional: override model or region
# STRIX_LLM=bedrock/qwen.qwen3-coder-30b-a3b-v1:0
# AWS_REGION_NAME=us-east-1

# ── Fallback: OpenRouter / Anthropic / OpenAI ─────────────────────────────────
# Uncomment and set if you prefer a different provider.
# STRIX_LLM=anthropic/claude-sonnet-4-6
# LLM_API_KEY=your_api_key_here

# Orchestrator port (frontend connects here)
PORT=7891
