FROM python:3.11-slim

# Run as non-root
RUN useradd --create-home appuser
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -r requirements.txt
USER appuser

HEALTHCHECK --interval=30s CMD curl -f http://localhost:8080/health || exit 1
